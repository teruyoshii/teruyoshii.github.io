---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Reel from '../components/Reel.astro';
import WorkThumb from '../components/WorkThumb.astro';
import { site, blogs, socials } from '../data/site';
import { fetchLatest } from '../lib/feeds';
import { getWorks, formatDate } from '../lib/works';

const works = (await getWorks()).slice(0, 6);
const posts = await fetchLatest(blogs, 4);
const about = await getEntry('profile', 'about');

const chapters = [
  { id: 'intro', label: 'Intro' },
  { id: 'works', label: 'Works' },
  { id: 'writing', label: 'Writing' },
  { id: 'about', label: 'About' },
];
---

<BaseLayout>
  <main class="deck" data-deck>
    <div class="stage" data-stage>
      <header class="label">
        <span class="label__side mono">SIDE A</span>
        <span class="label__title">{site.name}</span>
        <span class="label__meta mono">T-120 · SP</span>
      </header>

      <div class="cassette">
        <div class="cassette__reel cassette__reel--left"><Reel side="left" tape={44} /></div>

        <div class="window" data-window>
          <div class="track" data-track>
            <section class="panel panel--intro" id="intro" data-panel>
              <p class="eyebrow" data-reveal>Portfolio</p>
              <h1 class="hero" data-reveal>{site.name}</h1>
              <p class="lead" data-reveal>{site.tagline}</p>
              <p class="hint mono" data-reveal>Scroll to play ▶</p>
            </section>

            <section class="panel" id="works" data-panel>
              <div class="panel__head" data-reveal>
                <p class="eyebrow">01 — Works</p>
                <h2>制作物</h2>
              </div>
              <ul class="works">
                {
                  works.map((work) => (
                    <li data-reveal>
                      <a class="work" href={`/works/${work.id}/`}>
                        <WorkThumb work={work} />
                        <span class="work__title">{work.data.title}</span>
                        <span class="work__date mono">{formatDate(work.data.date)}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
              <a class="more mono" href="/works/" data-reveal>すべての制作物 ▶</a>
            </section>

            <section class="panel" id="writing" data-panel>
              <div class="panel__head" data-reveal>
                <p class="eyebrow">02 — Writing</p>
                <h2>ブログ</h2>
              </div>
              <ul class="blogs">
                {
                  blogs.map((b) => (
                    <li data-reveal>
                      {b.url ? (
                        <a class="blog" href={b.url} target="_blank" rel="noopener">
                          <span class="blog__name">{b.name}</span>
                          <span class="mono">▶</span>
                        </a>
                      ) : (
                        <span class="blog blog--soon">
                          <span class="blog__name">{b.name}</span>
                          <span class="mono">準備中</span>
                        </span>
                      )}
                    </li>
                  ))
                }
              </ul>
              {
                posts.length > 0 && (
                  <ul class="posts" data-reveal>
                    {posts.map((p) => (
                      <li>
                        <a href={p.url} target="_blank" rel="noopener">
                          <span class="mono">{formatDate(p.date)}</span>
                          <span>{p.title}</span>
                          <span class="mono posts__src">{p.source}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )
              }
            </section>

            <section class="panel" id="about" data-panel>
              <div class="panel__head" data-reveal>
                <p class="eyebrow">03 — About</p>
                <h2>{site.name}</h2>
              </div>
              <p class="lead" data-reveal>{about?.data.summary}</p>
              <ul class="socials" data-reveal>
                {
                  socials.map((s) => (
                    <li>
                      <a href={s.url} target="_blank" rel="noopener">{s.name}</a>
                    </li>
                  ))
                }
              </ul>
              <a class="more mono" href="/about/" data-reveal>プロフィールを見る ▶</a>
            </section>
          </div>
        </div>

        <div class="cassette__reel cassette__reel--right"><Reel side="right" tape={90} /></div>
      </div>

      <footer class="bar">
        <span class="bar__state mono"><i class="bar__dot"></i>PLAY</span>
        <nav class="chapters" aria-label="セクション">
          {
            chapters.map((c, i) => (
              <a class="chapter mono" href={`#${c.id}`} data-chapter={i}>
                {c.label}
              </a>
            ))
          }
        </nav>
        <span class="bar__counter mono" data-counter>00:00:00</span>
      </footer>
    </div>
  </main>
</BaseLayout>

<script>
  import { initDeck } from '../scripts/deck';
  initDeck();
</script>

<style>
  /* ---------- 共通（スマホ・動きを減らす設定・JS なしでもこの表示） ---------- */
  .stage {
    padding: 0 var(--gutter);
  }
  .label {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 0;
    background: color-mix(in srgb, var(--c-bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--c-line);
  }
  .label__title {
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .label__side,
  .label__meta {
    font-size: 0.7rem;
    color: var(--c-muted);
  }
  .cassette__reel {
    display: none;
  }
  .panel {
    padding: clamp(56px, 12vw, 120px) 0;
    border-bottom: 1px solid var(--c-line);
  }
  .panel--intro {
    min-height: 70svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero {
    margin: 0;
    font-size: clamp(3rem, 12vw, 7.5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    background: linear-gradient(100deg, var(--c-ink) 30%, var(--c-accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead {
    margin: 1em 0 0;
    max-width: 40ch;
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--c-muted);
  }
  .hint {
    margin-top: 3em;
    font-size: 0.75rem;
    color: var(--c-accent);
  }
  .panel__head h2 {
    margin: 0 0 1.2em;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .works {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .work {
    display: grid;
    gap: 6px;
    text-decoration: none;
  }
  .work__title {
    font-weight: 600;
    line-height: 1.4;
  }
  .work__date {
    font-size: 0.7rem;
    color: var(--c-muted);
  }
  .work:hover .work__title {
    color: var(--c-accent);
  }
  .more {
    display: inline-block;
    margin-top: 2em;
    font-size: 0.8rem;
    color: var(--c-accent);
    text-decoration: none;
  }
  .blogs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .blog {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 24px;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.03);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  a.blog:hover {
    border-color: var(--c-accent);
    background: rgb(183 148 255 / 0.08);
  }
  .blog__name {
    font-size: 1.25rem;
    font-weight: 800;
  }
  .blog--soon {
    color: var(--c-muted);
  }
  .blog--soon .mono {
    font-size: 0.7rem;
  }
  .posts {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .posts a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--c-line);
    text-decoration: none;
  }
  .posts .mono {
    font-size: 0.75rem;
    color: var(--c-muted);
  }
  .socials {
    display: flex;
    gap: 20px;
    margin: 1.5em 0 0;
    padding: 0;
    list-style: none;
  }
  .socials a {
    color: var(--c-accent);
    text-underline-offset: 4px;
  }
  .bar {
    display: none;
  }

  /* ---------- デッキ表示（PC で動きが許可されているときに JS が付与） ---------- */
  :global(html.is-deck) .stage {
    height: 100vh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: clamp(12px, 2.5vh, 28px);
    padding: clamp(16px, 3vh, 32px) var(--gutter);
  }
  :global(html.is-deck) .label {
    position: static;
    background: none;
    backdrop-filter: none;
    border: 0;
    padding: 0;
  }
  :global(html.is-deck) .cassette {
    position: relative;
    display: grid;
    grid-template-columns: var(--reel) minmax(0, 1fr) var(--reel);
    align-items: center;
    gap: clamp(16px, 2vw, 32px);
    min-height: 0;
    padding: clamp(16px, 3vh, 32px);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(80% 120% at 50% 0%, rgb(54 12 105 / 0.55), transparent 70%),
      var(--c-shell);
    --reel: min(24vh, 17vw);
  }
  :global(html.is-deck) .cassette__reel {
    display: block;
  }
  :global(html.is-deck) .cassette__reel :global(.reel) {
    width: var(--reel);
    height: var(--reel);
  }
  :global(html.is-deck) .window {
    --shift: 0px;
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--c-bg);
    /* 上下の線はリールの間を走るテープ */
    box-shadow:
      0 -3px 0 var(--c-tape),
      0 3px 0 var(--c-tape),
      inset 0 0 0 1px var(--c-line);
  }
  :global(html.is-deck) .window::after {
    /* うっすら走査線 */
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(to bottom, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 3px);
  }
  :global(html.is-deck) .track {
    display: flex;
    height: 100%;
    width: calc(var(--panels) * 100%);
    will-change: transform;
  }
  :global(html.is-deck) .panel {
    flex: 0 0 calc(100% / var(--panels));
    height: 100%;
    overflow: hidden;
    padding: clamp(24px, 5vh, 56px) clamp(24px, 4vw, 64px);
    border: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  :global(html.is-deck) .panel h2 {
    text-shadow:
      var(--shift) 0 rgb(255 61 127 / 0.5),
      calc(var(--shift) * -1) 0 rgb(61 242 255 / 0.5);
  }
  :global(html.is-deck) .hero {
    font-size: clamp(3rem, 9vw, 8rem);
  }
  :global(html.is-deck) .works {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 1.5vw, 20px);
  }
  :global(html.is-deck) .panel__head h2 {
    margin-bottom: 0.8em;
  }
  :global(html.is-deck) .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    font-size: 0.75rem;
    color: var(--c-muted);
  }
  .bar__state {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .bar__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: 0 0 12px var(--c-accent);
    animation: blink 1.6s steps(2, start) infinite;
  }
  @keyframes blink {
    to {
      visibility: hidden;
    }
  }
  .chapters {
    display: flex;
    gap: 6px;
  }
  .chapter {
    padding: 6px 14px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .chapter:hover {
    color: var(--c-ink);
  }
  .chapter.is-active {
    background: var(--c-brand);
    color: var(--c-ink);
  }
  .bar__counter {
    justify-self: end;
    font-size: 0.9rem;
    color: var(--c-ink);
  }
</style>
