---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Reel from '../components/Reel.astro';
import WorkThumb from '../components/WorkThumb.astro';
import { site, blogs, socials } from '../data/site';
import { fetchLatest } from '../lib/feeds';
import { getWorks, formatDate } from '../lib/works';

const works = (await getWorks()).slice(0, 6);
const posts = await fetchLatest(blogs, 3);
const about = await getEntry('profile', 'about');

// 左リール（画像側）と右リール（説明側）に載る1組ずつのコンテンツ。並び順がそのまま再生順になる
// chapter はチャプターボタンの名前。同じ chapter が続く場合は最初の1組にだけ付ける
const kinds = { video: 'Video', illustration: 'Illustration', other: 'Work' } as const;
const chapters = ['Intro', 'Works', 'Writing', 'About'];
const chapterStarts = [0, 1, 1 + works.length, 2 + works.length];
---

<BaseLayout>
  <main class="deck" data-deck>
    <div class="stage" data-stage>
      <header class="label">
        <span class="label__side mono">SIDE A</span>
        <span class="label__title">{site.name}</span>
        <span class="label__meta mono">T-120 · SP</span>
      </header>

      <div class="hub hub--left" data-hub="left" aria-hidden="true"><Reel side="left" tape={44} /></div>
      <div class="hub hub--right" data-hub="right" aria-hidden="true"><Reel side="right" tape={90} /></div>

      <div class="pairs" data-pairs>
        <section class="pair" id="intro" data-pair aria-label="Intro">
          <div class="side side--l card card--title" data-side="l">
            <p class="eyebrow">Portfolio</p>
            <p class="hero">{site.name}</p>
          </div>
          <div class="side side--r card card--text" data-side="r">
            <h1 class="text__title">{site.tagline}</h1>
            <p class="text__body">{site.description}</p>
            <p class="hint mono">Scroll to play ▶</p>
          </div>
        </section>

        {
          works.map((work, i) => (
            <section class="pair" id={i === 0 ? 'works' : undefined} data-pair aria-label={work.data.title}>
              <a class="side side--l card card--media" data-side="l" href={`/works/${work.id}/`} tabindex="-1" aria-hidden="true">
                <WorkThumb work={work} />
              </a>
              <div class="side side--r card card--text" data-side="r">
                <p class="eyebrow">
                  Works {String(i + 1).padStart(2, '0')} · {kinds[work.data.kind]}
                </p>
                <h2 class="text__title">{work.data.title}</h2>
                <p class="text__body">{work.data.summary}</p>
                <p class="text__meta mono">{formatDate(work.data.date)}</p>
                <a class="more mono" href={`/works/${work.id}/`}>詳しく見る ▶</a>
              </div>
            </section>
          ))
        }

        <section class="pair" id="writing" data-pair aria-label="Writing">
          <div class="side side--l card card--title" data-side="l">
            <p class="eyebrow">Writing</p>
            <p class="hero hero--sub">{blogs.map((b) => b.name).join(' / ')}</p>
          </div>
          <div class="side side--r card card--text" data-side="r">
            <p class="eyebrow">Blog</p>
            <h2 class="text__title">ブログ</h2>
            <ul class="links">
              {
                blogs.map((b) => (
                  <li>
                    {b.url ? (
                      <a href={b.url} target="_blank" rel="noopener">
                        {b.name} ▶
                      </a>
                    ) : (
                      <span class="muted">{b.name}（準備中）</span>
                    )}
                  </li>
                ))
              }
            </ul>
            {
              posts.length > 0 && (
                <ul class="posts">
                  {posts.map((p) => (
                    <li>
                      <a href={p.url} target="_blank" rel="noopener">
                        <span class="mono">{formatDate(p.date)}</span> {p.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }
          </div>
        </section>

        <section class="pair" id="about" data-pair aria-label="About">
          <div class="side side--l card card--title" data-side="l">
            <p class="eyebrow">About</p>
            <p class="avatar" aria-hidden="true">{site.name.charAt(0)}</p>
          </div>
          <div class="side side--r card card--text" data-side="r">
            <p class="eyebrow">Profile</p>
            <h2 class="text__title">{site.name}</h2>
            <p class="text__body">{about?.data.summary}</p>
            <ul class="links links--row">
              {
                socials.map((s) => (
                  <li>
                    <a href={s.url} target="_blank" rel="noopener">
                      {s.name}
                    </a>
                  </li>
                ))
              }
            </ul>
            <a class="more mono" href="/about/">プロフィールを見る ▶</a>
          </div>
        </section>
      </div>

      <div class="hud" aria-hidden="true">
        <span class="hud__index mono" data-index>01</span>
        <span class="hud__line"></span>
        <span class="hud__total mono">{String(chapterStarts[3] + 1).padStart(2, '0')}</span>
      </div>

      <footer class="bar">
        <span class="bar__state mono"><i class="bar__dot"></i>PLAY</span>
        <nav class="chapters" aria-label="セクション">
          {
            chapters.map((c, i) => (
              <a class="chapter mono" href={`#${c.toLowerCase()}`} data-chapter={chapterStarts[i]}>
                {c}
              </a>
            ))
          }
        </nav>
        <span class="bar__counter mono" data-counter>00:00:00</span>
      </footer>
    </div>
  </main>
</BaseLayout>

<script>
  import { initDeck } from '../scripts/deck';
  initDeck();
</script>

<style>
  /* ---------- 共通（スマホ・動きを減らす設定・JS なしでもこの表示） ---------- */
  .stage {
    padding: 0 var(--gutter);
  }
  .label {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 0;
    background: color-mix(in srgb, var(--c-bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--c-line);
  }
  .label__title {
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .label__side,
  .label__meta {
    font-size: 0.7rem;
    color: var(--c-muted);
  }
  .hub,
  .hud,
  .bar {
    display: none;
  }

  .pair {
    display: grid;
    gap: 16px;
    padding: clamp(40px, 8vw, 80px) 0;
    border-bottom: 1px solid var(--c-line);
  }
  @media (min-width: 640px) {
    .pair {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 32px;
    }
  }

  .card {
    border-radius: var(--radius-md);
    text-decoration: none;
  }
  .card--title,
  .card--media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--c-line);
    background:
      radial-gradient(120% 90% at 20% 0%, rgb(91 42 168 / 0.6), transparent 60%),
      linear-gradient(160deg, var(--c-brand), var(--c-shell));
  }
  .card--title {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(20px, 3vw, 36px);
  }
  .card--media :global(.thumb) {
    height: 100%;
    aspect-ratio: auto;
    border-radius: 0;
  }
  .hero {
    margin: 0;
    font-size: 17cqi;
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .hero--sub {
    font-size: 11cqi;
  }
  .avatar {
    margin: auto;
    display: grid;
    place-items: center;
    width: 45%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 2px solid var(--c-accent);
    font-size: 14cqi;
    font-weight: 800;
  }
  .card--text {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .text__title {
    margin: 0 0 0.5em;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .text__body {
    margin: 0;
    color: var(--c-muted);
  }
  .text__meta {
    margin: 0.8em 0 0;
    font-size: 0.75rem;
    color: var(--c-muted);
  }
  .hint {
    margin: 2em 0 0;
    font-size: 0.75rem;
    color: var(--c-accent);
  }
  .more {
    align-self: flex-start;
    margin-top: 1.5em;
    font-size: 0.8rem;
    color: var(--c-accent);
    text-decoration: none;
  }
  .links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
    font-size: 1.1rem;
    font-weight: 600;
  }
  .links--row {
    display: flex;
    gap: 20px;
    margin-top: 1.2em;
    font-size: 1rem;
  }
  .links a {
    color: var(--c-accent);
    text-decoration: none;
  }
  .muted {
    color: var(--c-muted);
  }
  .posts {
    margin: 1.2em 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
  }
  .posts a {
    display: block;
    padding: 6px 0;
    border-top: 1px solid var(--c-line);
    text-decoration: none;
  }
  .posts .mono {
    color: var(--c-muted);
    font-size: 0.75rem;
  }

  /* ---------- デッキ表示（PC で動きが許可されているときに JS が付与） ---------- */
  /* カードの位置と回転は deck.ts が毎フレーム計算して transform で置く */
  :global(html.is-deck) .stage {
    position: relative;
    height: 100vh;
    overflow: hidden;
    padding: 0;
    background: radial-gradient(60% 70% at 50% 50%, rgb(54 12 105 / 0.35), transparent 70%);
  }
  :global(html.is-deck) .label {
    position: absolute;
    inset: 0 0 auto;
    padding: clamp(16px, 3vh, 28px) var(--gutter);
    background: none;
    backdrop-filter: none;
    border: 0;
  }
  :global(html.is-deck) .pair {
    display: contents;
  }
  :global(html.is-deck) .side {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    width: var(--card-w);
    height: var(--card-h);
    will-change: transform, opacity;
  }
  :global(html.is-deck) .card--title,
  :global(html.is-deck) .card--media {
    aspect-ratio: auto;
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.45);
  }
  :global(html.is-deck) .card--text {
    padding: 0 clamp(8px, 1.5vw, 24px);
  }
  :global(html.is-deck) .hub {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: var(--hub);
    height: var(--hub);
  }
  :global(html.is-deck) .hub :global(.reel) {
    width: 100%;
    height: 100%;
  }
  :global(html.is-deck) .hud {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    transform: translate(-50%, -50%);
    font-size: 0.75rem;
    color: var(--c-muted);
  }
  .hud__index {
    font-size: 1.1rem;
    color: var(--c-ink);
  }
  .hud__line {
    width: 1px;
    height: 48px;
    background: linear-gradient(var(--c-accent), transparent);
  }
  :global(html.is-deck) .bar {
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: clamp(16px, 3vh, 28px) var(--gutter);
    font-size: 0.75rem;
    color: var(--c-muted);
  }
  .bar__state {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .bar__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: 0 0 12px var(--c-accent);
    animation: blink 1.6s steps(2, start) infinite;
  }
  @keyframes blink {
    to {
      visibility: hidden;
    }
  }
  .chapters {
    display: flex;
    gap: 6px;
  }
  .chapter {
    padding: 6px 14px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .chapter:hover {
    color: var(--c-ink);
  }
  .chapter.is-active {
    background: var(--c-brand);
    color: var(--c-ink);
  }
  .bar__counter {
    justify-self: end;
    font-size: 0.9rem;
    color: var(--c-ink);
  }
</style>
