---
import { getEntry, render } from 'astro:content';
import ProseLayout from '../layouts/ProseLayout.astro';

const about = await getEntry('profile', 'about');
if (!about) throw new Error('src/content/profile/about.md がありません');
const { Content } = await render(about);
---

<ProseLayout title={about.data.title} description={about.data.summary} eyebrow="Profile">
  <p class="lead">{about.data.summary}</p>
  <div class="prose">
    <Content />
  </div>
</ProseLayout>

<style>
  .lead {
    margin: 0 0 2em;
    font-size: 1.15rem;
    color: var(--c-muted);
  }
</style>
